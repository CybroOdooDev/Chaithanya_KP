<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_pos_kitchen_printer_form" model="ir.ui.view">
        <field name="name">pos.kitchen.printer.form</field>
        <field name="model">pos.kitchen.printer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="ip_address"/>
                        <field name="port"/>
                        <field name="pos_config_ids" widget="many2many_tags"/>
                        <field name="category_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_kitchen_printer_tree" model="ir.ui.view">
        <field name="name">pos.kitchen.printer.tree</field>
        <field name="model">pos.kitchen.printer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="ip_address"/>
                <field name="port"/>
            </list>
        </field>
    </record>

    <record id="action_pos_kitchen_printer" model="ir.actions.act_window">
        <field name="name">Kitchen Printers</field>
        <field name="res_model">pos.kitchen.printer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
