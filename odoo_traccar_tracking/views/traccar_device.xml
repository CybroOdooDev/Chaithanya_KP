<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_traccar_device_tree" model="ir.ui.view">
        <field name="name">traccar.device.tree</field>
        <field name="model">traccar.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="traccar_id"/>
                <field name="vehicle_id"/>
            </list>
        </field>
    </record>

    <record id="view_traccar_device_form" model="ir.ui.view">
        <field name="name">traccar.device.form</field>
        <field name="model">traccar.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_devices"
                            string="Sync Devices"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="traccar_id"/>
                        <field name="unique_id"/>
                        <field name="vehicle_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_traccar_device" model="ir.actions.act_window">
        <field name="name">Traccar</field>
        <field name="res_model">traccar.device</field>
        <field name="view_mode">list,form</field>
    </record>

