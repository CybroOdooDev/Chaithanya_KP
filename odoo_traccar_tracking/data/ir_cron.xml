<!-- data/ir_cron.xml -->
<odoo>
    <record id="cron_traccar_sync" model="ir.cron">
        <field name="name">Traccar Data Sync</field>
        <field name="model_id" ref="model_traccar_device"/>
        <field name="state">code</field>
        <field name="code">
            model.sync_devices();
            model.sync_positions()
        </field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
