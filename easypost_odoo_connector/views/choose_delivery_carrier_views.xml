<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Inherited to add a message regardinhg easypost-->
    <record id="choose_delivery_carrier_view_form" model="ir.ui.view">
        <field name="name">
            choose.delivery.carrier.view.form.inherit.easypost.odoo.connector
        </field>
        <field name="model">choose.delivery.carrier</field>
        <field name="inherit_id"
               ref="stock_delivery.choose_delivery_carrier_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_price']" position="after">
                <div invisible= "delivery_type != 'easypost'">
                    It shows the estimated rate. Real shipping cost will be
                    added only after validating the delivery.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
