<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--   Inherited Delivery Carrier form view to add Easypost fields-->
    <record id="view_delivery_carrier_form" model="ir.ui.view">
        <field name="name">delivery.carrier.view.form.inherit.easypost
            .odoo.connector
        </field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='destination']" position='after'>
                <page string="Easypost Configuration"
                      name="easypost_configuration" invisible ="delivery_type != 'easypost'">
                    <group>
                        <field name="easypost_api_key" password="1"
                               required = "delivery_type == 'easypost'"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
